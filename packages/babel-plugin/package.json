{
  "name": "@ng-react/babel-plugin-hmr",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "description": "Feasibility proof: gives ng-react modules Metro HMR out of the box, with no hand-written HMR code in module files and no per-module wiring in the composition root.",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "main": "./src/index.ts",
  "scripts": {
    "typecheck": "tsc --noEmit --pretty"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/template": "^7.29.7",
    "@babel/traverse": "^7.29.8",
    "@babel/types": "^7.29.8",
    "@ng-react/eslint-config-modules": "workspace:*",
    "@ng-react/kernel": "workspace:*",
    "@types/babel__core": "^7.20.5",
    "@types/babel__template": "^7.4.4",
    "@types/babel__traverse": "^7.20.6",
    "babel-preset-expo": "^57.0.7",
    "metro-runtime": "^0.84.5"
  }
}
